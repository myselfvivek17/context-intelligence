# Bearer key for MCP clients, REST and the web console login.
MCP_API_KEY=change-me
# Optional: TypeSafe Jev key for the System One judge (entity/key/conflict decisions). Without it (and
# without Laya) the server still works, but only exact subject+relation matches supersede.
TYPESAFE_API_KEY=
# jev | laya | none
JUDGE_BACKEND=jev
# 1 to build the optional local Laya judge into the image (~2.5 GB RAM while it runs).
WITH_LAYA=0
# true to serve the web console at /ui
WEB_UI=false
PORT=8084
